# Configuration de déploiement — FDS Portail
# À copier sous le nom .env sur votre serveur Linux (Proxmox)

# Base de données PostgreSQL
POSTGRES_USER=fds_admin
POSTGRES_PASSWORD=change_this_to_a_secure_password
POSTGRES_DB=fds_portail

# Port HTTP public
PORT=80

# Environnement
ENVIRONMENT=production

# URL publique du portail (lien de suivi dans les emails), ex. https://candidature.fds.ueh.edu.ht
APP_BASE_URL=http://localhost

# Email de confirmation (Resend). Laisser RESEND_API_KEY vide : les emails sont alors écrits dans les journaux
# du conteneur backend (mode console) et la candidature fonctionne normalement.
RESEND_API_KEY=
EMAIL_FROM=FDS Portail <onboarding@resend.dev>

# Session du personnel (US-011). Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Premier compte admin, créé une seule fois par : docker compose exec backend python -m backend.scripts.seed_admin
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=

# false : aucun email envoyé (ni Resend, ni mode console). Par défaut : true
EMAIL_ENABLED=true
